PUBLIC_BASE_URL=https://your-tunnel.example
PUBLIC_HOSTNAME=demo.example.com
INTERNAL_API_TOKEN=replace_with_at_least_24_random_characters
DEMO_LOGIN_PASSWORD=replace_with_a_shared_demo_password
DEMO_SESSION_MINUTES=480
DASHBOARD_ORIGIN=http://localhost:5173
HAWLAK_CONTROL_TOKEN=replace_with_a_separate_32_byte_random_token

# Chosen WhatsApp transport for the Medathon demo
WHATSAPP_PROVIDER=meta

# Optional fallback transport. The current demo uses Meta, not Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=replace_with_version_shown_in_meta_dashboard
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_VERIFY_TOKEN=create_a_long_random_value
META_APP_SECRET=replace_me
# The patient test number is entered in the synthetic case. It is not stored here.

# Text AI: approved-plan wording and dialect only
DEMO_PROVIDER_MODE=mock
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_STT_MODEL=replace_with_an_available_transcription_model_id
OPENAI_LLM_MODEL=replace_with_an_available_model_id
OPENAI_CLASSIFIER_MODEL=replace_with_an_available_model_id

# Voice AI: exact approved script only
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_ID=replace_with_a_native_saudi_arabic_voice_id
ELEVENLABS_VOICE_LABEL=Configured Saudi Arabic voice
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=opus_48000_64
ELEVENLABS_LANGUAGE_CODE=ar
# Natural, warm delivery. Lower stability is more expressive; similarity keeps the chosen voice.
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY_BOOST=0.80

# Conversational telephone follow-up worker
HAWLAK_AGENT_MODE=mock
HAWLAK_API_BASE_URL=http://127.0.0.1:3000
HAWLAK_AGENT_NAME=hawlak-follow-up
HAWLAK_AGENT_CONTROL_PORT=3100
HAWLAK_AGENT_CONTROL_URL=http://127.0.0.1:3100
LIVEKIT_URL=wss://replace-with-your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_replace_me

# Persistence
DATABASE_URL=postgresql://hawlak:hawlak@127.0.0.1:15432/hawlak
POSTGRES_USER=hawlak
POSTGRES_DB=hawlak
POSTGRES_PASSWORD=replace_with_a_random_alphanumeric_password
# Host-side API uses Hawlak's dedicated port. Docker overrides this with http://minio:9000.
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=hawlak-mvp
S3_ACCESS_KEY=hawlak_local
S3_SECRET_KEY=replace_me

