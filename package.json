{
  "name": "hawlak-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Hawlak patient voice, WhatsApp intake, and pharmacist review workflow MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --reload-dir app --port 3000",
    "dev:webhook": "uv run --directory apps/api uvicorn app.webhook_main:app --port 3001 --no-access-log",
    "test:api": "uv run --directory apps/api pytest",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:worker": "uv run --directory apps/api python -m app.delivery_worker"
  },
  "engines": {
    "node": ">=22"
  }
}
